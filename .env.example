# Docker Compose 环境变量示例：cp .env.example .env 后填写实际值
# .env 已被 .gitignore 忽略，切勿将真实密钥提交到仓库

# ===== 必填 =====
# MySQL root 密码（容器初始化时设置）
DB_PASSWORD=change-me

# 阿里云 DashScope API Key（大模型服务）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# Java 与 Python 之间共享的 JWT 密钥（两侧必须一致，compose 已自动注入两侧）
AI_API_SHARED_JWT_SECRET=change-me-strong-secret

# 阿里云 OSS（头像/文档上传）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# ===== 可选 =====
# DeepSeek API Key（对话命名备用 LLM，缺省时降级为默认标题）
DEEPSEEK_API_KEY=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=darkside
OSS_REGION=cn-beijing
