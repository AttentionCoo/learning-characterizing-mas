# Docker Compose 环境变量示例：cp .env.example .env 后填写实际值
# .env 已被 .gitignore 忽略，切勿将真实密钥提交到仓库

# ===== 必填 =====
# MySQL root 密码（容器初始化时设置）
DB_PASSWORD=change-me

# 讯飞星火对话模型 APIPassword（控制台 → 星火大模型 → 对应版本右上角获取）
# 默认兜底密码（所有档位缺省时共用）
SPARK_API_PASSWORD=your-spark-api-password

# 按档位独立密码（不配则回退到 SPARK_API_PASSWORD）
# MAX 档：Ultra-32K / Pro-128K（Agent proposer 长提示词场景）
SPARK_API_PASSWORD_MAX=
# PRO 档：Spark Pro（critic / 反思）
SPARK_API_PASSWORD_PRO=
# LITE 档：轻量任务（QA生成/标题/摘要），建议复用 Pro 密码
SPARK_API_PASSWORD_LITE=

# 星火模型档位覆盖（默认 ultra / generalv3 / generalv3）
#SPARK_MODEL_MAX=generalv3
#SPARK_MODEL_PRO=generalv3
#SPARK_MODEL_LITE=generalv3

# Base URL 覆盖（默认 https://spark-api-open.xf-yun.com/v1）
# 不同服务可能用不同端点（如 Spark X 用 /x2），可按档位覆盖
#SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
#SPARK_BASE_URL_MAX=
#SPARK_BASE_URL_PRO=
#SPARK_BASE_URL_LITE=

# 讯飞应用三元组（控制台 → 我的应用），图片理解与文本向量化的签名鉴权使用
XFYUN_APP_ID=your-app-id
XFYUN_API_KEY=your-api-key
XFYUN_API_SECRET=your-api-secret

# 讯飞文本向量化（embedding）服务控制
# - XFYUN_EMBEDDING_ENABLED=false 可直接跳过讯飞 embedding，全程使用本地 BGE 模型
#   适用于：未开通讯飞 embedding 服务、额度已耗尽、或偏好纯离线运行
#   设置为 false 后无需重试等待，向量库构建速度更快
#XFYUN_EMBEDDING_ENABLED=true
# 自定义 embedding 服务地址（默认使用官方 HTTP 接口 https://emb-cn-huabei-1.xf-yun.com/）
#XFYUN_EMBEDDING_URL=https://emb-cn-huabei-1.xf-yun.com/

# Java 与 Python 之间共享的 JWT 密钥（两侧必须一致，compose 已自动注入两侧）
AI_API_SHARED_JWT_SECRET=change-me-strong-secret

# 阿里云 OSS（头像/文档上传）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# ===== 可选 =====
# 星火模型档位覆盖（默认 ultra / generalv3 / lite）
#SPARK_MODEL_MAX=generalv3
#SPARK_MODEL_PRO=generalv3
#SPARK_MODEL_LITE=lite
# 图片理解版本：general=基础版（默认），imagev3=高级版
#XFYUN_IMAGE_DOMAIN=general
# 阿里云 DashScope Key（可选）：仅供 Rerank 精排与医学影像子系统(qwen-vl)使用,
# 不配则精排自动禁用、医学影像分析不可用,其余功能不受影响
DASHSCOPE_API_KEY=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=darkside
OSS_REGION=cn-beijing
