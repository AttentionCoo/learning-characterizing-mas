# ===========================================
# Backend (Java Spring Boot) .gitignore
# ===========================================

# --- Maven 构建输出 ---
target/
*.jar
*.war

# --- IDE 配置 ---
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# --- 日志文件 ---
logs/
*.log

# --- 服务器部署配置（含数据库密码、OSS密钥等敏感信息）---
application-prod-server.yml

# --- 操作系统临时文件 ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- 临时文件 ---
*.tmp
*.temp
.cache/