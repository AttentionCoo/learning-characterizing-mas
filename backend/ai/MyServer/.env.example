# Java 后端环境变量示例（复制为实际环境变量或通过启动脚本注入，Spring 不会自动读取 .env 文件）
# 所有密钥类变量均无默认值，不设置将导致启动失败——这是有意为之，防止密钥进入代码库。

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medai
DB_USERNAME=root
DB_PASSWORD=your-db-password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Python 模型服务 =====
AI_API_URL=http://localhost:8000
# 需与 model/.env 中 SECRET_KEY 一致
AI_JWT_SECRET=dev-local-secret
# 生产环境使用（application-prod.yml）
AI_API_SHARED_JWT_SECRET=your-strong-jwt-secret

# ===== 阿里云 OSS =====
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
